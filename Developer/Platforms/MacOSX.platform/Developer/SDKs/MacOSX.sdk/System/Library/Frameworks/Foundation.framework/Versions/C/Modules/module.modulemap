// Template for the SDK's <sdk>/System/Library/Frameworks/Foundation.framework/
// Modules/module.modulemap, emitted by tools/generate-sdk-modulemap.py
// (frameworks/<Name>/ goes to the framework's Versions/Current/Modules).
//
// Fundation is a framework module in Apple's SDK and not a usr/include one, so
// the Swift Foundation overlay's `import Foundation` needs this file: without
// it the build stops with "underlying Objective-C module 'Foundation' not
// found" for every source in overlays/Foundation/.
//
// Apple's own Foundation.modulemap adds `module * { export * }` over the 201
// headers in this framework's Headers directory, which makes every one of them
// an inferred submodule.  Here the umbrella alone is declared: Darling's
// Foundation headers are not all modular-clean, and the overlay needs the
// Foundation API, not Apple's submodule layout.  Add submodules as clients need
// them, with their headers checked against this tree.

framework module Foundation [system] {
    umbrella header "Foundation.h"
    export *
}
